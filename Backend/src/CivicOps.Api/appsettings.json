{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=civic_operations;Username=civic_ops;Password=civic_ops_dev",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=500,asyncTimeout=250,syncTimeout=250"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Authentication": {
    "Enabled": true,
    "Authority": "http://localhost:4200/auth/realms/civicops",
    "MetadataAddress": "http://localhost:8081/auth/realms/civicops/.well-known/openid-configuration",
    "Issuer": "http://localhost:4200/auth/realms/civicops",
    "Audience": "civicops-api",
    "RequireHttpsMetadata": false
  },
  "IdentityAccess": {
    "BootstrapEnabled": false
  },
  "DashboardCache": {
    "Enabled": true,
    "TimeToLive": "00:00:30"
  },
  "OutboxMetrics": {
    "Enabled": true,
    "CollectionInterval": "00:00:15"
  },
  "OutboxPublisher": {
    "Enabled": false,
    "BatchSize": 20,
    "PollingInterval": "00:00:05",
    "LockDuration": "00:00:30",
    "FailureDelay": "00:00:05"
  },
  "AttachmentStorage": {
    "RootPath": "../../.data/attachments",
    "MaximumSizeBytes": 26214400
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "civic_ops",
    "Password": "civic_ops_dev",
    "VirtualHost": "/",
    "ExchangeName": "civicops.events"
  },
  "NotificationsConsumer": {
    "Enabled": false,
    "QueueName": "civicops.notifications.request-assigned",
    "PrefetchCount": 16,
    "RetryExchangeName": "civicops.notifications.retry",
    "RetryDelays": [
      "00:00:05",
      "00:00:30",
      "00:02:00"
    ],
    "DeadLetterExchangeName": "civicops.notifications.dead-letter",
    "DeadLetterQueueName": "civicops.notifications.request-assigned.dead-letter"
  },
  "OpenTelemetry": {
    "ServiceName": "civic-operations-platform",
    "Otlp": {
      "Enabled": false,
      "Endpoint": "http://localhost:4317"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
