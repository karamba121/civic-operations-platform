@host = http://localhost:5080
@tenantId = 11111111-1111-1111-1111-111111111111
@userId = 33333333-3333-3333-3333-333333333333
@readerUserId = 44444444-4444-4444-4444-444444444444
@operatorUserId = 55555555-5555-5555-5555-555555555555

GET {{host}}/health
Accept: application/json

### Inicializar administrador do tenant
POST {{host}}/api/v1/access/bootstrap
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

### Conceder papel de leitura
PUT {{host}}/api/v1/access/members/{{readerUserId}}
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

{
  "role": "Reader"
}

### Conceder papel operacional
PUT {{host}}/api/v1/access/members/{{operatorUserId}}
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

{
  "role": "Operator"
}

### Listar membros e permissões
GET {{host}}/api/v1/access/members
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

###

POST {{host}}/api/v1/requests
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}
Idempotency-Key: request-demo-001

{
  "title": "Manutenção da iluminação pública",
  "description": "Poste sem iluminação na Avenida Central."
}

###

GET {{host}}/api/v1/requests?page=1&pageSize=20&search=iluminação&status=Submitted
Accept: application/json
X-Tenant-Id: {{tenantId}}

###

@requestId = 00000000-0000-0000-0000-000000000000

GET {{host}}/api/v1/requests/{{requestId}}
Accept: application/json
X-Tenant-Id: {{tenantId}}

###

@responsibleUserId = 22222222-2222-2222-2222-222222222222
@version = 00000000-0000-0000-0000-000000000000

PATCH {{host}}/api/v1/requests/{{requestId}}/assignment
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

{
  "responsibleUserId": "{{responsibleUserId}}",
  "version": "{{version}}"
}

###

PATCH {{host}}/api/v1/requests/{{requestId}}/status
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

{
  "status": "InProgress",
  "version": "{{version}}"
}

###

PATCH {{host}}/api/v1/requests/{{requestId}}/due-date
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

{
  "dueDateUtc": "2026-12-31T23:59:59Z",
  "version": "{{version}}"
}

###

POST {{host}}/api/v1/requests/{{requestId}}/comments
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

{
  "content": "Equipe responsável acionada."
}

###

GET {{host}}/api/v1/requests/{{requestId}}/comments?page=1&pageSize=20
Accept: application/json
X-Tenant-Id: {{tenantId}}

###

GET {{host}}/api/v1/requests/{{requestId}}/audit?page=1&pageSize=20
Accept: application/json
X-Tenant-Id: {{tenantId}}

###

GET {{host}}/api/v1/notifications?page=1&pageSize=20
Accept: application/json
X-Tenant-Id: {{tenantId}}
X-User-Id: {{responsibleUserId}}

### Enviar anexo
POST {{host}}/api/v1/requests/{{requestId}}/attachments
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}
Content-Type: multipart/form-data; boundary=CivicOpsBoundary

--CivicOpsBoundary
Content-Disposition: form-data; name="file"; filename="evidence.pdf"
Content-Type: application/pdf

Conteúdo de exemplo do anexo.
--CivicOpsBoundary--

### Listar anexos
GET {{host}}/api/v1/requests/{{requestId}}/attachments
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}

### Baixar anexo
GET {{host}}/api/v1/requests/{{requestId}}/attachments/{{attachmentId}}/content
X-Tenant-Id: {{tenantId}}
X-User-Id: {{userId}}
